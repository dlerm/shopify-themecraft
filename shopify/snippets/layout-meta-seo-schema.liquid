<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "{{ shop.name }}",
      "url": "{{ shop.url }}",
      "description": "{{ shop.description | strip_newlines | escape }}",
      "logo": {
        "@type": "ImageObject",
        "url": "https:{{ shop.brand.logo | image_url : width: 500 }}",
        "width": 500,
        "height": {{ 500 | divided_by: shop.brand.logo.aspect_ratio | round }}
      },
      "sameAs": [
        "https://www.instagram.com/<brand-handle>",
        "https://x.com/<brand-handle>",
        "https://www.tiktok.com/@<brand-handle>"
      ],
      {% comment %}
      "founder": {
        "@type": "Person",
        "name": "<Founder>"
      },
      {% endcomment %}
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{ shop.address.address1 }}",
        "addressLocality": "{{ shop.address.city }}",
        "addressRegion": "{{ shop.address.province }}",
        "postalCode": "{{ shop.address.zip }}",
        "addressCountry": "{{ shop.address.country }}"
      }
    },
    {
      "@type": "WebSite",
      "url": "{{ shop.url }}",
      "name": "{{ shop.name }}"
    }{%- if template.name == 'product' %},
    {
      "@type": "Product",
      "@id": "{{ shop.url }}{{ product.url }}#product",
      "name": "{{ product.title | escape }} {{ product.type | escape }}",
      "url": "{{ shop.url }}{{ product.url }}",
      "image": "{{ product | image_url: width: 500 }}",
      "description": "{{ product.description | strip_html | strip_newlines | escape }}",
      "brand": {
        "@type": "Brand",
        "name": "{{ shop.name }}"
      },
      {% comment %}
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "{{ product.metafields.reviews.rating.value }}",
        "reviewCount": "{{ product.metafields.reviews.rating_count }}",
        "bestRating": "{{ product.metafields.reviews.rating.scale_max }}"
      },
      {% endcomment %}
      "offers": [
        {% for variant in product.variants -%}
          {
            "@type": "Offer",
            "sku": "{{ variant.sku }}",
            "url": "{{ shop.url }}{{ product.url}}?variant={{ variant.id }}",
            "priceCurrency": "{{ shop.currency }}",
            "price": "{{ variant.price| money_without_currency }}",
            "itemCondition": "https://schema.org/NewCondition",
            "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
            "seller": {
              "@type": "Organization",
              "name": "{{ shop.name }}"
            }
            {% comment %} ,
            "itemOffered": {
              "@type": "Product",
              "name": "{{ product.title | escape }} {{ variant.title | escape }}",
              "identifier": "{{ variant.sku }}"
            } {% endcomment %}
          }{%- unless forloop.last -%},{%- endunless -%}
        {% endfor -%}
      ]
    }
    {%- endif -%}
  ]
}
</script>
